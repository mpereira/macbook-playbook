#!/usr/bin/python3 -I
# /usr/local/bin/touch-id-secret-lock-state KEYCHAIN_PATH
# Print "locked" or "unlocked". Unlike the security command, this never opens a
# password dialog on a locked keychain. Exit 1 if the state can't be read: an
# error must not read as "locked". SecKeychainGetStatus is deprecated.
import ctypes, os, sys

K_SEC_UNLOCK_STATE_STATUS = 1

if len(sys.argv) != 2:
    sys.exit("usage: touch-id-secret-lock-state KEYCHAIN_PATH")

security = ctypes.CDLL("/System/Library/Frameworks/Security.framework/Security")
security.SecKeychainOpen.argtypes = [ctypes.c_char_p, ctypes.POINTER(ctypes.c_void_p)]
security.SecKeychainOpen.restype = ctypes.c_int32
security.SecKeychainGetStatus.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint32)]
security.SecKeychainGetStatus.restype = ctypes.c_int32

keychain = ctypes.c_void_p()
code = security.SecKeychainOpen(os.fsencode(sys.argv[1]), ctypes.byref(keychain))
if code != 0:
    sys.exit(f"touch-id-secret-lock-state: SecKeychainOpen returned {code}")

status = ctypes.c_uint32()
code = security.SecKeychainGetStatus(keychain, ctypes.byref(status))
if code != 0:
    sys.exit(f"touch-id-secret-lock-state: SecKeychainGetStatus returned {code}")

print("unlocked" if status.value & K_SEC_UNLOCK_STATE_STATUS else "locked")
