#!/bin/bash
# Test the logic of the touch-id-secret command against stubs of security, age and
# its plugin, and check what test-touch-id-secret reports for each result it can see.
# It needs no Touch ID, Keychain or installed command, stores only dummy values in a
# temp directory, and so works inside an agent's sandbox. It doesn't show that the
# real tools behave like the stubs: test-touch-id-secret does that.
#
# Usage: test-touch-id-secret-logic [template]
#
# template is the command's source, by default the role's. Pass an older copy to see
# which of these tests would have caught its bugs. A copy from before init became
# put needs that rename first.
set -uo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
stubs="$here/stubs"
template="${1:-$here/../templates/touch-id-secret.j2}"

work="$(mktemp -d "${TMPDIR:-/tmp}/test-touch-id-secret-logic.XXXXXX")" || exit 1
trap 'rm -rf "${work:?}"' EXIT
state_directory="$work/state"
mkdir "$state_directory" "$work/home"
export HOME="$work/home"
store="$HOME/.local/share/touch-id-secret"
rendered="$work/touch-id-secret"

pass=0
fail=0
skip=0
ok() { pass=$((pass + 1)); printf 'ok   %s\n' "$1"; }
no() { fail=$((fail + 1)); printf 'FAIL %s\n' "$1"; }
check() { local label="$1"; shift; if "$@"; then ok "$label"; else no "$label"; fi; }
count() { if [[ -f "$1" ]]; then wc -l <"$1" | tr -d ' '; else echo 0; fi; }
empty() { [[ ! -s "$1" ]]; }
# Run a command with a flag file the stubs read, since the command clears the environment.
flagged() {
  local flag="$1" code
  shift
  touch "$state_directory/$flag"
  "$@"
  code=$?
  rm -f "${state_directory:?}/${flag:?}"
  return $code
}
wait_for() { local tries=0; while ((tries++ < 100)); do [[ -e "$1" ]] && return 0; sleep 0.05; done; return 1; }

# Ansible renders the real one. This handles its one variable and points PATH at the stubs.
sed -e 's/{{ touch_id_secret_idle_timeout_seconds | int }}/60/' \
  -e "s|^export PATH=.*|export PATH=\"$stubs:/usr/bin:/bin\"|" \
  "$template" >"$rendered" || exit 1
chmod 700 "$rendered"
# So that a stray relative path lands here, not in the caller's directory.
cd "$work" || exit 1
check "the template has no other Jinja syntax" sh -c "! grep -q -e '{{' -e '{%' -e '{#' '$rendered'"

printf 'dummy with spaces "double" \x27single\x27 \\back $HOME `id` #x \xc3\xbc\nline two\n' >"$work/secret1"
printf 'nul\x00byte and trailing newlines\n\n' >"$work/secret2"
printf 'replacement' >"$work/secret3"

"$rendered" put demo <"$work/secret1" >"$work/out" 2>"$work/err"; rc=$?
check "put exits 0" [ $rc -eq 0 ]
check "put stdout empty" empty "$work/out"
check "put wrote only stderr diagnostics" grep -q stored "$work/err"
check "identity present" test -f "$store/demo/identity.txt"
check "encrypted password present" test -f "$store/demo/keychain-password.age"
check "keychain present" test -f "$store/demo/demo.keychain-db"
check "storage is 0700" test "$(/usr/bin/stat -f %Lp "$store")" = 700
check "secret dir is 0700" test "$(/usr/bin/stat -f %Lp "$store/demo")" = 700
check "put left it locked" test "$(cat "$store/demo/demo.keychain-db.state")" = locked
check "no staging left" test -z "$(find "$store" -maxdepth 1 -name '.demo.*')"
check "any-biometry requested" grep -q 'keygen --access-control=any-biometry' "$state_directory/argv.log"
check "timeout rendered and applied" grep -q 'set-keychain-settings -l -u -t 60 ' "$state_directory/argv.log"

p0=$(count "$state_directory/prompts")
"$rendered" get demo >"$work/out" 2>"$work/err"; rc=$?
check "get after lock exits 0" [ $rc -eq 0 ]
check "get returns exact bytes" cmp -s "$work/secret1" "$work/out"
check "get after lock prompts once" test "$(($(count "$state_directory/prompts") - p0))" = 1
p1=$(count "$state_directory/prompts")
"$rendered" get demo >"$work/out" 2>"$work/err" </dev/null; rc=$?
check "second get with no stdin exits 0" [ $rc -eq 0 ]
check "second get exact" cmp -s "$work/secret1" "$work/out"
check "second get doesn't prompt" test "$(count "$state_directory/prompts")" = "$p1"
check "second get stderr empty" empty "$work/err"

"$stubs/security" lock-keychain "$store/demo/demo.keychain-db"
flagged cancel "$rendered" get demo >"$work/out" 2>"$work/err"; rc=$?
check "cancelled get exits 1" [ $rc -eq 1 ]
check "cancelled get stdout empty" empty "$work/out"
check "cancelled get doesn't touch security" test "$(count "$state_directory/dialogs")" = 0
check "cancelled get stays locked" test "$(cat "$store/demo/demo.keychain-db.state")" = locked

printf x | "$rendered" put demo >"$work/out" 2>"$work/err"; rc=$?
check "refuses overwrite with 1" [ $rc -eq 1 ]
"$rendered" get demo >"$work/out" 2>/dev/null
check "refused overwrite kept secret" cmp -s "$work/secret1" "$work/out"

flagged fail-create "$rendered" put --force demo <"$work/secret3" >"$work/out" 2>"$work/err"; rc=$?
check "failed rotation exits nonzero" [ $rc -ne 0 ]
check "failed rotation stdout empty" empty "$work/out"
check "failed rotation cleans staging" test -z "$(find "$store" -maxdepth 1 -name '.demo.*')"
"$rendered" get demo >"$work/out" 2>/dev/null
check "failed rotation kept old secret" cmp -s "$work/secret1" "$work/out"

flagged cancel "$rendered" put --force demo <"$work/secret3" >"$work/out" 2>"$work/err"; rc=$?
check "cancelled rotation exits nonzero" [ $rc -ne 0 ]
check "cancelled rotation cleans staging" test -z "$(find "$store" -maxdepth 1 -name '.demo.*')"
"$rendered" get demo >"$work/out" 2>/dev/null
check "cancelled rotation kept old secret" cmp -s "$work/secret1" "$work/out"

"$rendered" put --force demo <"$work/secret3" >"$work/out" 2>"$work/err"; rc=$?
check "force exits 0" [ $rc -eq 0 ]
check "force leaves nothing beside it" test -z "$(find "$store" -maxdepth 1 -name '.demo.*')"
"$rendered" get demo >"$work/out" 2>/dev/null
check "force replaced the secret" cmp -s "$work/secret3" "$work/out"

"$rendered" put binary <"$work/secret2" >/dev/null 2>&1
"$rendered" get binary >"$work/out" 2>/dev/null
check "NUL and trailing newlines survive" cmp -s "$work/secret2" "$work/out"

for bad in '../escape' 'a/b' '.hidden' '-rf' '' 'with space' $'new\nline' '..' "$(printf 'x%.0s' {1..65})"; do
  "$rendered" get "$bad" >"$work/out" 2>/dev/null; rc=$?
  check "get rejects '${bad//$'\n'/\\n}' with 2" [ $rc -eq 2 ]
  check "  and empty stdout" empty "$work/out"
  printf x | "$rendered" put "$bad" >"$work/out" 2>/dev/null; rc=$?
  check "put rejects '${bad//$'\n'/\\n}' with 2" [ $rc -eq 2 ]
done
check "nothing escaped the store" test ! -e "$HOME/.local/share/escape"
"$rendered" get "$(printf 'x%.0s' {1..64})" >/dev/null 2>&1; rc=$?
check "64 characters is a valid name (fails 1, unknown)" [ $rc -eq 1 ]

"$rendered" >/dev/null 2>&1; check "no args exits 2" [ $? -eq 2 ]
"$rendered" bogus >/dev/null 2>&1; check "unknown command exits 2" [ $? -eq 2 ]
"$rendered" get >/dev/null 2>&1; check "get with no name exits 2" [ $? -eq 2 ]
"$rendered" get a b >/dev/null 2>&1; check "get with two names exits 2" [ $? -eq 2 ]
"$rendered" put </dev/null >/dev/null 2>&1; check "put with no name exits 2" [ $? -eq 2 ]
"$rendered" get missing >"$work/out" 2>/dev/null; rc=$?
check "get unknown exits 1" [ $rc -eq 1 ]
check "get unknown stdout empty" empty "$work/out"

"$rendered" put emptyone </dev/null >"$work/out" 2>"$work/err"; rc=$?
check "empty stdin exits 1" [ $rc -eq 1 ]
check "empty stdin creates nothing" test ! -e "$store/emptyone"

# script needs a pseudo-terminal, which an agent's sandbox may not allow.
script -q /dev/null "$rendered" put ttyone >"$work/tty-out" 2>&1 </dev/null; rc=$?
if grep -q 'reads the secret from stdin' "$work/tty-out"; then
  ok "terminal stdin refused"
else
  skip=$((skip + 1))
  printf 'skip terminal stdin (script exited %s): %s\n' "$rc" "$(tr -d '\r' <"$work/tty-out" | head -1)"
fi

keychain="$store/demo/demo.keychain-db"
mv "$keychain.state" "$keychain.state.saved"
"$rendered" get demo >"$work/out" 2>"$work/err"; rc=$?
check "helper error exits 1" [ $rc -eq 1 ]
check "helper error stdout empty" empty "$work/out"
check "helper error isn't treated as locked" test "$(grep -c '^age -d' "$state_directory/argv.log")" -gt 0
mv "$keychain.state.saved" "$keychain.state"

echo unlocked >"$keychain.state"
printf 'not hex' >"$keychain.item.bad"
cp "$keychain.item" "$keychain.item.good"
cp "$keychain.item.bad" "$keychain.item"
"$rendered" get demo >"$work/out" 2>"$work/err"; rc=$?
check "malformed item exits 1" [ $rc -eq 1 ]
check "malformed item stdout empty" empty "$work/out"
cp "$keychain.item.good" "$keychain.item"

# The item read fails: the timer expired between the check and the read.
echo locked >"$keychain.state"
flagged report-unlocked "$rendered" get demo >"$work/out" 2>"$work/err"; rc=$?
check "read failure exits 1" [ $rc -eq 1 ]
check "read failure stdout empty" empty "$work/out"

# security -i splits long lines, so nothing near that length may reach it.
"$rendered" put --force demo <"$work/secret3" >/dev/null 2>&1
overhead="$(printf 'add-generic-password -a touch-id-secret -s demo -w  "%s"\n' "$store/.demo.XXXXXX/demo.keychain-db" | wc -c)"
largest=$(((4000 - overhead) / 2))
head -c "$largest" /dev/zero | tr '\0' s >"$work/largest"
{ cat "$work/largest"; printf s; } >"$work/oversized"
calls_before=$(count "$state_directory/argv.log")
"$rendered" put --force demo <"$work/oversized" >"$work/out" 2>"$work/err"; rc=$?
check "oversized secret exits 1" [ $rc -eq 1 ]
check "oversized secret stdout empty" empty "$work/out"
check "oversized secret stays out of stderr" sh -c "! grep -q 7373 '$work/err'"
check "oversized error names the limit" grep -q 'limit is 4000' "$work/err"
check "oversized secret runs nothing" test "$(count "$state_directory/argv.log")" = "$calls_before"
check "oversized secret leaves no staging" test -z "$(find "$store" -maxdepth 1 -name '.demo.*')"
"$rendered" get demo >"$work/out" 2>/dev/null
check "oversized secret kept the old one" cmp -s "$work/secret3" "$work/out"
"$rendered" put --force demo <"$work/largest" >"$work/out" 2>"$work/err"; rc=$?
check "largest secret exits 0" [ $rc -eq 0 ]
"$rendered" get demo >"$work/out" 2>/dev/null
check "largest secret exact" cmp -s "$work/largest" "$work/out"
"$rendered" put --force 'digits.-_0' <"$work/secret3" >/dev/null 2>&1
longest="$(awk '{print length($0) + 1}' "$state_directory/stdin-lines" | sort -n | tail -1)"
check "longest security -i line was the 4000-byte limit ($longest)" test "$longest" -le 4000 -a "$longest" -ge 3999

# Nothing the caller exported may reach a child process.
exported=(AGEDEBUG=plugin password=caller secret_hex=caller decrypted=caller stored_hex=caller keychain=caller state=caller recipient=caller quoted_keychain=caller variable=caller)
env "${exported[@]}" "$rendered" put envcheck <"$work/secret3" >"$work/out" 2>"$work/err"; rc=$?
check "put works with exported look-alikes" [ $rc -eq 0 ]
"$stubs/security" lock-keychain "$store/envcheck/envcheck.keychain-db"
env "${exported[@]}" "$rendered" get envcheck >"$work/out" 2>"$work/err"; rc=$?
check "get works with exported look-alikes" [ $rc -eq 0 ]
check "get with look-alikes returns exact bytes" cmp -s "$work/secret3" "$work/out"
check "the stubs logged child environments" test -s "$state_directory/child-env.log"
for variable in "${exported[@]}"; do
  check "${variable%%=*} never reaches a child" sh -c "! grep -q '^${variable%%=*}=' '$state_directory/child-env.log'"
done
check "children keep HOME, PATH and LC_ALL" sh -c "grep -q '^HOME=' '$state_directory/child-env.log' && grep -q '^PATH=' '$state_directory/child-env.log' && grep -q '^LC_ALL=C$' '$state_directory/child-env.log'"

# A second put of a name waits for nothing: it fails while the first runs.
touch "$state_directory/slow"
"$rendered" put race <"$work/secret1" >"$work/race-out" 2>"$work/race-err" &
first=$!
wait_for "$store/.race.lock"
check "put holds the lock while it runs" test -d "$store/.race.lock"
"$rendered" put race <"$work/secret3" >"$work/out" 2>"$work/err"; rc=$?
check "concurrent put exits 1" [ $rc -eq 1 ]
check "concurrent put stdout empty" empty "$work/out"
check "concurrent put names the lock" grep -qF "$store/.race.lock" "$work/err"
"$rendered" put --force race <"$work/secret3" >"$work/out" 2>"$work/err"; rc=$?
check "concurrent put --force exits 1" [ $rc -eq 1 ]
"$rendered" get demo >"$work/out" 2>/dev/null; rc=$?
check "another name isn't blocked" [ $rc -eq 0 ]
wait "$first"; rc=$?
rm -f "${state_directory:?}/slow"
check "first put succeeds" [ $rc -eq 0 ]
check "lock released on success" test ! -e "$store/.race.lock"
"$rendered" get race >"$work/out" 2>/dev/null
check "first put's secret is stored" cmp -s "$work/secret1" "$work/out"
check "nothing nested in the secret" test -z "$(find "$store/race" -mindepth 1 -maxdepth 1 -name '.*')"
check "nothing left beside the secret" test -z "$(find "$store" -maxdepth 1 -name '.race.*')"

# Both reach the publish step with no secret: the second must not replace or nest.
touch "$state_directory/slow"
"$rendered" put overlap <"$work/secret1" >/dev/null 2>&1 &
first=$!
wait_for "$store/.overlap.lock"
"$rendered" put overlap <"$work/secret3" >/dev/null 2>&1; rc=$?
check "overlapping put without --force exits 1" [ $rc -eq 1 ]
wait "$first"
rm -f "${state_directory:?}/slow"
"$rendered" get overlap >"$work/out" 2>/dev/null
check "overlapping put doesn't replace the secret" cmp -s "$work/secret1" "$work/out"

# A lock left by a killed put.
mkdir -p "$store/.stale.lock"
"$rendered" put stale <"$work/secret1" >"$work/out" 2>"$work/err"; rc=$?
check "stale lock blocks put" [ $rc -eq 1 ]
check "stale lock error names it" grep -qF "$store/.stale.lock" "$work/err"
check "put keeps a lock it doesn't own" test -d "$store/.stale.lock"
rmdir "$store/.stale.lock"
"$rendered" put stale <"$work/secret1" >/dev/null 2>&1; rc=$?
check "put works once it's removed" [ $rc -eq 0 ]
mkdir "$store/.stale.lock"
"$rendered" get stale >"$work/out" 2>/dev/null; rc=$?
check "get ignores the lock" [ $rc -eq 0 ]
rmdir "$store/.stale.lock"

# SIGTERM runs the EXIT trap, so nothing is left behind.
touch "$state_directory/slow"
"$rendered" put term <"$work/secret1" >/dev/null 2>&1 &
first=$!
wait_for "$store/.term.lock"
kill -TERM "$first"
wait "$first"; rc=$?
rm -f "${state_directory:?}/slow"
sleep 1.2
check "SIGTERM makes put fail" [ $rc -ne 0 ]
check "SIGTERM releases the lock" test ! -e "$store/.term.lock"
check "SIGTERM removes staging" test -z "$(find "$store" -maxdepth 1 -name '.term.*')"
check "SIGTERM stores nothing" test ! -e "$store/term"

# The same signal while mktemp runs: the directory exists, but put hasn't got its
# path yet. The pattern leaves out the lock, whose suffix has four characters.
touch "$state_directory/slow-mktemp"
"$rendered" put mid <"$work/secret1" >/dev/null 2>&1 &
first=$!
tries=0
while ((tries++ < 100)) && [[ -z "$(find "$store" -maxdepth 1 -name '.mid.??????')" ]]; do sleep 0.05; done
check "the signal arrives once mktemp has made the directory" test -n "$(find "$store" -maxdepth 1 -name '.mid.??????')"
kill -TERM "$first"
wait "$first"; rc=$?
rm -f "${state_directory:?}/slow-mktemp"
sleep 1.2
check "SIGTERM during mktemp makes put fail" [ $rc -ne 0 ]
check "SIGTERM during mktemp releases the lock" test ! -e "$store/.mid.lock"
check "SIGTERM during mktemp removes staging" test -z "$(find "$store" -maxdepth 1 -name '.mid.*')"

# SIGTERM during the swap keeps exactly one secret at the final path.
"$rendered" put swap <"$work/secret1" >/dev/null 2>&1
flagged term-after-aside "$rendered" put --force swap <"$work/secret3" >/dev/null 2>&1; rc=$?
check "SIGTERM after the first move fails put" [ $rc -ne 0 ]
"$rendered" get swap >"$work/out" 2>/dev/null
check "SIGTERM after the first move restores the old secret" cmp -s "$work/secret1" "$work/out"
check "SIGTERM after the first move leaves nothing beside it" test -z "$(find "$store" -maxdepth 1 -name '.swap*')"
flagged term-after-publish "$rendered" put --force swap <"$work/secret3" >/dev/null 2>&1; rc=$?
check "SIGTERM after the second move reports failure" [ $rc -ne 0 ]
"$rendered" get swap >"$work/out" 2>/dev/null
check "SIGTERM after the second move keeps the new secret" cmp -s "$work/secret3" "$work/out"
check "SIGTERM after the second move leaves nothing beside it" test -z "$(find "$store" -maxdepth 1 -name '.swap*')"

# Secrets and keychain passwords must only have been on stdin to security -i.
grep -E '^(create-keychain|unlock-keychain)' "$state_directory/stdin-lines" | awk '{print $3}' | sort -u >"$work/passwords"
grep -E '^add-generic-password' "$state_directory/stdin-lines" | awk '{print $7}' | sort -u >"$work/hexes"
check "the stubs captured passwords" test -s "$work/passwords"
check "the stubs captured hexes" test -s "$work/hexes"
check "no password in logged argv" sh -c "! grep -qFf '$work/passwords' '$state_directory/argv.log'"
check "no secret hex in logged argv" sh -c "! grep -qFf '$work/hexes' '$state_directory/argv.log'"
check "no password in a child environment" sh -c "! grep -qFf '$work/passwords' '$state_directory/child-env.log'"
check "no secret hex in a child environment" sh -c "! grep -qFf '$work/hexes' '$state_directory/child-env.log'"
check "no secret text in logged argv" sh -c "! grep -qF 'replacement' '$state_directory/argv.log' && ! grep -qF 'dummy with' '$state_directory/argv.log'"
check "output captures hold no password" sh -c "! grep -qFf '$work/passwords' '$work/err' '$work/out'"
check "one security -i line per session" test "$(grep -c '^security -i$' "$state_directory/argv.log")" = "$(wc -l <"$state_directory/stdin-lines" | tr -d ' ')"

# The rest checks what test-touch-id-secret reports, so that a run on the Mac can be
# believed. Each run sources it in a subshell and replaces what needs the real tools.

# Load the tests and take out the questions and the waiting.
load_real_tests() {
  # shellcheck source=roles/touch-id-secret/tests/test-touch-id-secret
  source "$here/test-touch-id-secret"
  ask() { [[ "$answer" == y ]]; }
  pause() { :; }
}

# Keep only the verdict of each line a test prints, on one line.
verdicts() {
  grep -E '^(PASS|FAIL|SKIP):' | cut -d: -f1 | paste -sd ' ' -
}

expect() {
  if [[ "$3" == "$2" ]]; then
    ok "$1: $2"
  else
    no "$1: expected '$2', got '$3'"
  fi
}

# Run the test function $1 against fakes. Each lock state comes from $2 in turn, the
# last one repeating. $3 is when a sleep shows up in the log: never, always or later,
# meaning from the second look. $4 is what show-keychain-info prints. $5 is the exit
# code of set-keychain-settings. $6 answers the questions. $7 is the exit code of a
# get after the first one.
with_fakes() {
  local test_function="$1" states="$2" sleep_records="$3" fake_settings="$4" set_rc="$5" answer="$6" later_get="$7"
  rm -f "${work:?}/state-calls" "${work:?}/log-calls" "${work:?}/get-calls"
  (
    load_real_tests
    name=fake
    keychain="$work/fake"
    printf '%s' "$dummy_secret" >"$work/expected"
    sleep() { :; }
    state() {
      local words calls
      read -r -a words <<<"$states"
      echo x >>"$work/state-calls"
      calls="$(count "$work/state-calls")"
      ((calls > ${#words[@]})) && calls=${#words[@]}
      echo "${words[calls - 1]}"
    }
    pmset_log() {
      echo x >>"$work/log-calls"
      echo '2000-01-01 00:00:00 +0100 Sleep               	Entering Sleep state before the test'
      if [[ "$sleep_records" == always || ("$sleep_records" == later && "$(count "$work/log-calls")" -gt 1) ]]; then
        printf '%s +0100 Sleep               	Entering Sleep state during the test\n' "$(/bin/date -v+1S '+%Y-%m-%d %H:%M:%S')"
      fi
    }
    security() {
      case "$1" in
        set-keychain-settings) return "$set_rc" ;;
        show-keychain-info) printf '%s\n' "$fake_settings" ;;
      esac
    }
    run_get() {
      echo x >>"$work/get-calls"
      rc=0
      [[ "$(count "$work/get-calls")" -eq 1 ]] || rc="$later_get"
      cp "$work/expected" "$work/stdout"
    }
    "$test_function" 2>&1 | verdicts
  )
}

raised='Keychain "x" lock-on-sleep timeout=3600s'
expect "test 6: locked across a recorded sleep" PASS \
  "$(with_fakes test_6 'unlocked unlocked locked' always "$raised" 0 y 0)"
expect "test 6: locked, no sleep recorded" SKIP \
  "$(with_fakes test_6 'unlocked unlocked locked' never "$raised" 0 y 0)"
expect "test 6: unlocked across a recorded sleep" FAIL \
  "$(with_fakes test_6 unlocked always "$raised" 0 y 0)"
expect "test 6: unlocked, no sleep recorded" SKIP \
  "$(with_fakes test_6 unlocked never "$raised" 0 y 0)"
expect "test 6: raising the timeout failed" FAIL \
  "$(with_fakes test_6 unlocked always "$raised" 1 y 0)"
expect "test 6: the timeout stayed at 60 seconds" FAIL \
  "$(with_fakes test_6 unlocked always 'Keychain "x" lock-on-sleep timeout=60s' 0 y 0)"
expect "test 6: lock-on-sleep missing" FAIL \
  "$(with_fakes test_6 unlocked always 'Keychain "x" timeout=3600s' 0 y 0)"

idle='Keychain "x" lock-on-sleep timeout=60s'
expect "timer: a read restarts the timer, then it locks" 'PASS PASS PASS' \
  "$(with_fakes test_timer_renewal 'unlocked locked' never "$idle" 0 y 0)"
expect "timer: a read doesn't restart the timer" 'FAIL PASS' \
  "$(with_fakes test_timer_renewal locked never "$idle" 0 y 0)"
expect "timer: it never locks" 'PASS FAIL PASS' \
  "$(with_fakes test_timer_renewal unlocked never "$idle" 0 y 0)"
expect "timer: the Mac slept before the first look" SKIP \
  "$(with_fakes test_timer_renewal locked always "$idle" 0 y 0)"
expect "timer: the Mac slept before the last look" 'PASS SKIP PASS' \
  "$(with_fakes test_timer_renewal 'unlocked locked' later "$idle" 0 y 0)"
expect "timer: more than one prompt" 'PASS PASS FAIL' \
  "$(with_fakes test_timer_renewal 'unlocked locked' never "$idle" 0 n 0)"
expect "timer: the second read fails" FAIL \
  "$(with_fakes test_timer_renewal unlocked never "$idle" 0 y 1)"
expect "timer: the timeout is too long to wait for" SKIP \
  "$(with_fakes test_timer_renewal unlocked never "$raised" 0 y 0)"
expect "timer: unexpected keychain settings" FAIL \
  "$(with_fakes test_timer_renewal unlocked never 'nothing useful' 0 y 0)"

# These run against the stubbed command rather than fakes.
dialogs_before="$(count "$state_directory/dialogs")"
stubbed_tests() {
  local answer=y
  (
    load_real_tests
    PATH="$stubs:$PATH"
    command_path="$rendered"
    helper_path="$stubs/touch-id-secret-lock-state"
    name=reported
    directory="$storage_directory/$name"
    keychain="$directory/$name.keychain-db"
    printf '%s' "$dummy_secret" >"$work/expected"
    printf '%s' "$dummy_secret" | "$command_path" put "$name" >/dev/null 2>&1
    test_environment
    test_put_lock
    test_rotation
    test_rotation_unlocked
  ) 2>&1
}
stubbed_tests >"$work/stubbed-tests"
stubbed_verdicts="$(verdicts <"$work/stubbed-tests")"
check "the environment, lock and rotation tests ran" test -n "$stubbed_verdicts"
if [[ -n "$stubbed_verdicts" && "$stubbed_verdicts" != *FAIL* && "$stubbed_verdicts" != *SKIP* ]]; then
  ok "the environment, lock and rotation tests all pass on the stubs"
else
  no "the environment, lock and rotation tests all pass on the stubs: $stubbed_verdicts"
  grep -E '^(FAIL|SKIP):' "$work/stubbed-tests"
fi
check "the tests read no settings of a locked keychain" test "$(count "$state_directory/dialogs")" = "$dialogs_before"

printf '\n%s passed, %s failed, %s skipped\n' "$pass" "$fail" "$skip"
[[ $fail -eq 0 ]]
