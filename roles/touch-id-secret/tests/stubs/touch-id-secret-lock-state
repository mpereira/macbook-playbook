#!/bin/bash
# Stub of the lock helper. The report-unlocked flag makes it disagree with the
# keychain, as when the idle timer expires between the check and the read.
state_directory="$HOME/../state"
/usr/bin/env >>"$state_directory/child-env.log"
printf 'lock-state %s\n' "$*" >>"$state_directory/argv.log"
[[ ! -f "$state_directory/report-unlocked" ]] || { echo unlocked; exit 0; }
[[ -f "$1.state" ]] || { echo "stub: missing" >&2; exit 1; }
cat "$1.state"
