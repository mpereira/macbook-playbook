#!/bin/bash
# Test the installed touch-id-secret command with a dummy secret and a throwaway
# name. Run it in a terminal outside any agent sandbox, after converging the
# role. It needs you for Touch ID and for sleeping the Mac, and removes what it
# creates.
#
# Usage: test-touch-id-secret                  tests 1 to 6, plus the extra checks
#        test-touch-id-secret sleep            test 6 alone
#        test-touch-id-secret timer            whether a read restarts the idle timer
#        test-touch-id-secret rotation         put --force on a locked and an unlocked keychain
#        test-touch-id-secret long-secret      the secret length limit alone
#        test-touch-id-secret sandbox-prepare  create the secret for test 7, outside the sandbox
#        test-touch-id-secret sandbox-check    run test 7's read; run this inside the sandbox
#        test-touch-id-secret sandbox-clean    remove the secret for test 7
set -uo pipefail

command_path=/usr/local/bin/touch-id-secret
helper_path=/usr/local/bin/touch-id-secret-lock-state
storage_directory="$HOME/.local/share/touch-id-secret"
sandbox_name=touch-id-secret-sandbox-check

# Spaces, both quotes, shell and security -i metacharacters, non-ASCII and
# newlines, so a quoting or encoding mistake changes the bytes.
dummy_secret=$'dummy secret  with spaces, "double" and \'single\' quotes, \\back\\slash, $HOME `id` #hash ünï\nsecond line\n'
rotated_secret='a different dummy secret'
unlocked_rotated_secret='a third dummy secret'

results=()
failures=0

record() {
  results+=("$1  $2")
  printf '%s: %s\n' "$1" "$2"
  [[ "$1" != FAIL ]] || failures=$((failures + 1))
}

ask() {
  local reply
  read -r -p "$1 [y/n] " reply </dev/tty
  [[ "$reply" == y* ]]
}

pause() {
  read -r -p "$1 Press Enter when ready. " _ </dev/tty
}

state() {
  "$helper_path" "$keychain" 2>&1
}

# Run get. Sets rc, and writes stdout and stderr to the two capture files.
run_get() {
  "$command_path" get "$name" >"$work/stdout" 2>"$work/stderr"
  rc=$?
  [[ ! -s "$work/stderr" ]] || sed 's/^/  stderr: /' "$work/stderr"
}

# True if the last get succeeded and printed exactly the bytes in the file $1.
got_exactly() {
  [[ $rc -eq 0 ]] && cmp -s "$1" "$work/stdout"
}

check_bin() {
  local tool
  for tool in "$command_path" "$helper_path" /opt/homebrew/bin/age /opt/homebrew/bin/age-plugin-se; do
    if [[ ! -x "$tool" ]]; then
      printf 'Missing %s. Run: make provision ARGS='"'"'--tags touch-id-secret'"'"'\n' "$tool" >&2
      exit 1
    fi
  done
}

remove_secret() {
  # No keychain here is on the search list, so removing the files removes it.
  rm -rf "$storage_directory/${1:?}" "$storage_directory/.$1."*
}

search_list() {
  security list-keychains -d user
  security default-keychain -d user
}

cleanup() {
  remove_secret "$name"
  cd / || exit 1
  rm -rf "$work"
  if [[ "$(search_list)" == "$search_list_before" ]]; then
    printf 'PASS: keychain search list and default keychain unchanged\n'
  else
    printf 'FAIL: keychain search list or default keychain changed. Before:\n%s\nAfter:\n' "$search_list_before"
    search_list
    exit 1
  fi
}

find_ansible_vault() {
  local candidate found=""
  if command -v ansible-vault; then
    return 0
  fi
  for candidate in "$HOME"/Library/Python/*/bin/ansible-vault; do
    [[ -x "$candidate" ]] && found="$candidate"
  done
  printf '%s\n' "$found"
}

test_validation() {
  local bad out code
  for bad in '../escape' 'a/b' '.hidden' '-rf' '' 'with space' $'new\nline' "$(printf 'x%.0s' {1..65})"; do
    out="$("$command_path" get "$bad" 2>/dev/null)"
    code=$?
    if [[ $code -eq 2 && -z "$out" ]]; then
      record PASS "get refuses the name '${bad//$'\n'/\\n}'"
    else
      record FAIL "get on the name '${bad//$'\n'/\\n}' exited $code"
    fi
    out="$(printf 'x' | "$command_path" put "$bad" 2>/dev/null)"
    code=$?
    if [[ $code -eq 2 && -z "$out" ]]; then
      record PASS "put refuses the name '${bad//$'\n'/\\n}'"
    else
      record FAIL "put on the name '${bad//$'\n'/\\n}' exited $code"
    fi
  done

  run_get
  [[ $rc -ne 0 && ! -s "$work/stdout" ]] \
    && record PASS "get on an unknown name fails with empty stdout" \
    || record FAIL "get on an unknown name exited $rc"

  out="$("$command_path" put "$name" </dev/null 2>/dev/null)"
  code=$?
  [[ $code -ne 0 && -z "$out" && ! -e "$directory" ]] \
    && record PASS "put refuses an empty secret" \
    || record FAIL "put with an empty secret exited $code"
}

test_put() {
  local out code mode path
  printf '\nInit: confirm the one Touch ID prompt that checks the new identity.\n'
  out="$(printf '%s' "$dummy_secret" | "$command_path" put "$name")"
  code=$?
  if [[ $code -ne 0 ]]; then
    record FAIL "put exited $code"
    printf 'Stopping: nothing else can run without the secret.\n'
    exit 1
  fi
  record PASS "put succeeds"
  [[ -z "$out" ]] && record PASS "put prints nothing to stdout" || record FAIL "put wrote to stdout"

  printf '  Stored files:\n'
  ls -la "$directory" | sed 's/^/    /'
  [[ -f "$keychain" ]] && record PASS "the keychain file is $name.keychain-db" || record FAIL "no keychain file at $keychain"
  for path in "$storage_directory" "$directory"; do
    mode="$(/usr/bin/stat -f '%Lp' "$path")"
    [[ "$mode" == 700 ]] && record PASS "$path has mode 0700" || record FAIL "$path has mode $mode"
  done
  [[ "$(state)" == locked ]] && record PASS "put leaves the keychain locked" || record FAIL "after put the keychain is $(state)"

  out="$(printf 'overwrite attempt' | "$command_path" put "$name" 2>/dev/null)"
  code=$?
  [[ $code -ne 0 && -z "$out" ]] \
    && record PASS "put refuses to overwrite without --force" \
    || record FAIL "put over an existing name exited $code"
}

test_1() {
  security lock-keychain "$keychain"
  printf '\nTest 1: get right after a lock. Touch ID should prompt once.\n'
  [[ "$(state)" == locked ]] || record FAIL "test 1 precondition: keychain is $(state)"
  run_get
  got_exactly "$work/expected" \
    && record PASS "1: get returns the exact secret (spaces, quotes, newlines)" \
    || record FAIL "1: get exited $rc or returned different bytes"
  ask "Exactly one Touch ID prompt?" \
    && record PASS "1: one Touch ID prompt" \
    || record FAIL "1: wrong number of Touch ID prompts reported"
  # A dialog here means the item needs -T /usr/bin/security.
  ask "No keychain password dialog?" \
    && record PASS "1: no keychain dialog (the item doesn't need -T)" \
    || record FAIL "1: a keychain dialog opened"
}

test_2() {
  printf '\nTest 2: a second get inside the window. Nothing should prompt.\n'
  [[ "$(state)" == unlocked ]] || record FAIL "test 2 precondition: keychain is $(state)"
  run_get
  got_exactly "$work/expected" \
    && record PASS "2: second get returns the exact secret" \
    || record FAIL "2: get exited $rc or returned different bytes"
  ask "No prompt at all?" && record PASS "2: no prompt" || record FAIL "2: prompted"
}

test_3() {
  local settings timeout
  # On a locked keychain, show-keychain-info opens a dialog. The window can have
  # passed while you answered test 2.
  if [[ "$(state)" != unlocked ]]; then
    printf '\nUnlocking it first. Touch ID should prompt once.\n'
    run_get
  fi
  [[ "$(state)" == unlocked ]] || {
    record FAIL "3: could not unlock the keychain"
    return
  }
  settings="$(security show-keychain-info "$keychain" 2>&1)"
  printf '\nTest 3: %s\n' "$settings"
  if [[ "$settings" =~ timeout=([0-9]+)s ]] && [[ "$settings" == *lock-on-sleep* ]]; then
    timeout="${BASH_REMATCH[1]}"
    record PASS "the keychain locks on sleep and after ${timeout}s idle"
  else
    record FAIL "unexpected keychain settings: $settings"
    return
  fi
  printf 'Waiting %s seconds for the idle timer.\n' "$((timeout + 5))"
  sleep "$((timeout + 5))"
  [[ "$(state)" == locked ]] \
    && record PASS "3: the keychain locked itself after the timeout" \
    || record FAIL "3: after the timeout the keychain is $(state)"
  printf 'Touch ID should prompt once.\n'
  run_get
  got_exactly "$work/expected" \
    && record PASS "3: get after the timeout returns the exact secret" \
    || record FAIL "3: get exited $rc or returned different bytes"
  ask "Exactly one Touch ID prompt?" && record PASS "3: prompted again" || record FAIL "3: wrong prompts reported"
}

test_4() {
  security lock-keychain "$keychain"
  printf '\nTest 4: press Cancel on the Touch ID prompt.\n'
  run_get
  [[ $rc -ne 0 ]] && record PASS "4: a cancelled prompt exits nonzero ($rc)" || record FAIL "4: a cancelled prompt exited 0"
  [[ ! -s "$work/stdout" ]] && record PASS "4: stdout is empty" || record FAIL "4: stdout isn't empty"
  [[ "$(state)" == locked ]] && record PASS "4: the keychain stays locked" || record FAIL "4: the keychain is $(state)"
  ask "No dialog left open?" && record PASS "4: no dialog left open" || record FAIL "4: a dialog stayed open"
}

test_5() {
  local ansible_vault
  security lock-keychain "$keychain"
  printf '\nTest 5: get with no TTY on stdin. Touch ID should prompt once.\n'
  "$command_path" get "$name" </dev/null >"$work/stdout" 2>"$work/stderr"
  rc=$?
  got_exactly "$work/expected" \
    && record PASS "5: works with stdin from /dev/null" \
    || record FAIL "5: with stdin from /dev/null, get exited $rc or returned different bytes"

  ansible_vault="$(find_ansible_vault)"
  if [[ -z "$ansible_vault" ]]; then
    record SKIP "5: ansible-vault not found, vault password file not run"
    return
  fi
  printf '%s\n' '#!/bin/sh' "exec $command_path get $name" >"$work/vault-password"
  chmod 700 "$work/vault-password"
  # Away from any ansible.cfg in the directory this was started from.
  cd "$work" || return

  security lock-keychain "$keychain"
  printf 'Touch ID should prompt once for ansible-vault encrypt_string.\n'
  printf 'dummy plaintext' \
    | "$ansible_vault" encrypt_string --vault-password-file "$work/vault-password" --stdin-name dummy \
      >"$work/encrypted.yml" 2>"$work/stderr"
  rc=$?
  if [[ $rc -ne 0 ]] || ! grep -q 'ANSIBLE_VAULT' "$work/encrypted.yml"; then
    record FAIL "5: ansible-vault encrypt_string exited $rc"
    sed 's/^/  stderr: /' "$work/stderr"
    return
  fi
  record PASS "5: ansible-vault encrypt_string works with the wrapper"

  sed -n 's/^ *//; /^\$ANSIBLE_VAULT/,$p' "$work/encrypted.yml" >"$work/encrypted.txt"
  security lock-keychain "$keychain"
  printf 'Touch ID should prompt once for ansible-vault decrypt.\n'
  "$ansible_vault" decrypt --vault-password-file "$work/vault-password" --output "$work/decrypted.txt" \
    "$work/encrypted.txt" >/dev/null 2>"$work/stderr"
  rc=$?
  if [[ $rc -eq 0 && "$(cat "$work/decrypted.txt")" == 'dummy plaintext' ]]; then
    record PASS "5: ansible-vault decrypt returns the plaintext with the wrapper"
  else
    record FAIL "5: ansible-vault decrypt exited $rc"
    sed 's/^/  stderr: /' "$work/stderr"
  fi
}

pmset_log() {
  /usr/bin/pmset -g log
}

# Sleeps logged at or after the local time $1. Comparing dates rather than counting
# lines, since the log can drop old lines.
sleep_records_since() {
  pmset_log \
    | awk -v since="$1" '/^[0-9-]+ [0-9:]+ [-+0-9]+ +Sleep / && ($1 " " $2) >= since'
}

# The README and the role's defaults say the timeout counts from the last read. Read
# at two thirds of the timeout and look again at four thirds. The keychain is then
# past the timeout since the unlock, but not since the read.
test_timer_renewal() {
  local settings timeout wait_seconds started after
  security lock-keychain "$keychain"
  printf '\nTimer: does a read restart the idle timer? Touch ID should prompt once. Keep the Mac awake.\n'
  run_get
  got_exactly "$work/expected" || {
    record FAIL "timer: get exited $rc or returned different bytes"
    return
  }
  settings="$(security show-keychain-info "$keychain" 2>&1)"
  if [[ ! "$settings" =~ timeout=([0-9]+)s ]]; then
    record FAIL "timer: unexpected keychain settings: $settings"
    return
  fi
  timeout="${BASH_REMATCH[1]}"
  if ((timeout > 300)); then
    record SKIP "timer: a ${timeout}s timeout would take too long"
    return
  fi
  wait_seconds=$((timeout * 2 / 3))
  started="$(date '+%Y-%m-%d %H:%M:%S')"

  printf 'Waiting %s seconds, then reading.\n' "$wait_seconds"
  sleep "$wait_seconds"
  run_get
  got_exactly "$work/expected" || {
    record FAIL "timer: the second get exited $rc or returned different bytes"
    return
  }
  printf 'Waiting %s more seconds, now past the timeout since the unlock.\n' "$wait_seconds"
  sleep "$wait_seconds"
  after="$(state)"
  if [[ -n "$(sleep_records_since "$started")" ]]; then
    record SKIP "timer: the Mac slept during the test, which proves nothing"
    return
  fi
  case "$after" in
    locked)
      record FAIL "timer: locked $wait_seconds seconds after a read, under the ${timeout}s timeout, so a read may not restart the timer: rerun this test before changing the docs"
      ;;
    unlocked)
      record PASS "timer: a read restarts the idle timer"
      printf 'Waiting %s seconds to check that it still locks after the last read.\n' "$((timeout + 5))"
      sleep "$((timeout + 5))"
      after="$(state)"
      if [[ -n "$(sleep_records_since "$started")" ]]; then
        record SKIP "timer: the Mac slept during the test, so the last lock proves nothing"
      elif [[ "$after" == locked ]]; then
        record PASS "timer: locked when checked $((wait_seconds + timeout + 5)) seconds after the last read"
      else
        record FAIL "timer: $((wait_seconds + timeout + 5)) seconds after the last read the keychain is $after"
      fi
      ;;
    *)
      record FAIL "timer: could not read the lock state: $after"
      ;;
  esac
  # A prompt for the second read would mean it had already locked, so the read
  # unlocked it rather than restarting anything.
  ask "Exactly one Touch ID prompt in this test?" \
    && record PASS "timer: one Touch ID prompt" \
    || record FAIL "timer: wrong number of Touch ID prompts reported"
}

test_6() {
  local started new_records settings attempt
  printf '\nTest 6: the keychain locks when the Mac sleeps.\n'
  ask "Run this test? It needs you to sleep and wake the Mac." || {
    record SKIP "6: not run"
    return
  }
  if [[ "$(state)" == locked ]]; then
    printf 'Unlocking it first. Touch ID should prompt once.\n'
    run_get
  fi
  [[ "$(state)" == unlocked ]] || {
    record FAIL "6: could not unlock the keychain"
    return
  }
  # So that only sleep can lock it during this test, not the idle timer.
  security set-keychain-settings -l -u -t 3600 "$keychain" || {
    record FAIL "6: could not raise the idle timeout"
    return
  }
  settings="$(security show-keychain-info "$keychain" 2>&1)"
  [[ "$settings" == *lock-on-sleep* && "$settings" == *timeout=3600s* ]] || {
    record FAIL "6: unexpected keychain settings: $settings"
    return
  }
  started="$(date '+%Y-%m-%d %H:%M:%S')"
  pause "Sleep the Mac now (Apple menu > Sleep). Leave it asleep for 30 seconds without touching it, wake it, come back here."
  # An earlier run saw no record right after waking, while the log showed the
  # sleep later, so give it time to appear.
  printf 'Looking for the sleep in pmset -g log, for up to 30 seconds.\n'
  for ((attempt = 0; attempt < 15; attempt++)); do
    new_records="$(sleep_records_since "$started")"
    [[ -z "$new_records" ]] || break
    sleep 2
  done
  printf 'Sleeps recorded since the prompt:\n%s\n' "${new_records:-  none}" | cut -c1-120
  if [[ -z "$new_records" ]]; then
    record SKIP "6: no sleep recorded and the keychain is $(state), which proves nothing: check pmset -g log"
  elif [[ "$(state)" == locked ]]; then
    record PASS "6: the keychain locked across a recorded sleep"
  else
    record FAIL "6: the keychain stayed $(state) across a recorded sleep"
  fi
}

# age logs its file key to stderr under AGEDEBUG=plugin, so the command clears it.
test_environment() {
  security lock-keychain "$keychain"
  printf '\nEnvironment: get with AGEDEBUG=plugin. Touch ID should prompt once.\n'
  AGEDEBUG=plugin "$command_path" get "$name" >"$work/stdout" 2>"$work/stderr"
  rc=$?
  got_exactly "$work/expected" \
    && record PASS "get works with AGEDEBUG=plugin set" \
    || record FAIL "with AGEDEBUG=plugin, get exited $rc or returned different bytes"
  # Don't print this stderr: it may hold the file key of this dummy secret.
  grep -q -e '^->' -e 'file-key' "$work/stderr" \
    && record FAIL "AGEDEBUG=plugin reached age: stderr has plugin protocol lines" \
    || record PASS "AGEDEBUG=plugin doesn't reach age"
}

test_put_lock() {
  local lock="$storage_directory/.$name.lock" out code
  printf '\nInit lock: put refuses to run while the lock exists. Nothing should prompt.\n'
  mkdir "$lock" || {
    record FAIL "could not create $lock"
    return
  }
  out="$(printf 'lock attempt' | "$command_path" put --force "$name" 2>"$work/stderr")"
  code=$?
  [[ $code -eq 1 && -z "$out" ]] \
    && record PASS "put refuses to run while another holds the lock" \
    || record FAIL "put with the lock held exited $code"
  grep -qF "$lock" "$work/stderr" \
    && record PASS "the error names the lock" \
    || record FAIL "the error doesn't name the lock"
  [[ -d "$lock" ]] \
    && record PASS "put leaves a lock it doesn't own" \
    || record FAIL "put removed a lock it doesn't own"
  rmdir "$lock"
}

# Store $2 with put --force, then check the result. $1 labels the results.
rotate_and_check() {
  local label="$1" code
  printf '%s' "$2" >"$work/rotated"
  printf 'Confirm the Touch ID prompt, then one more for the get. If a keychain password dialog opens, cancel it.\n'
  "$command_path" put --force "$name" <"$work/rotated"
  code=$?
  [[ $code -eq 0 ]] && record PASS "$label: put --force succeeds" || record FAIL "$label: put --force exited $code"
  if compgen -G "$storage_directory/.$name.*" >/dev/null; then
    record FAIL "$label: put --force left files behind"
  else
    record PASS "$label: put --force leaves nothing behind"
  fi
  [[ "$(state)" == locked ]] \
    && record PASS "$label: the new keychain starts locked" \
    || record FAIL "$label: right after put --force, the keychain is $(state)"
  run_get
  got_exactly "$work/rotated" \
    && record PASS "$label: get returns the new secret" \
    || record FAIL "$label: get exited $rc or returned different bytes"
  ask "Exactly two Touch ID prompts?" \
    && record PASS "$label: two Touch ID prompts" \
    || record FAIL "$label: wrong number of Touch ID prompts reported"
  ask "No keychain password dialog?" \
    && record PASS "$label: no keychain dialog" \
    || record FAIL "$label: a keychain dialog opened"
}

test_rotation() {
  security lock-keychain "$keychain"
  printf '\nRotation while locked.\n'
  rotate_and_check "rotation while locked" "$rotated_secret"
}

# The swap replaces a file at a path where securityd holds an unlocked keychain.
test_rotation_unlocked() {
  local settings
  printf '\nRotation while unlocked. If the keychain is locked, Touch ID prompts once to unlock it.\n'
  run_get
  [[ "$(state)" == unlocked ]] || {
    record FAIL "rotation while unlocked: could not unlock the keychain"
    return
  }
  # So that the old keychain is still unlocked at the swap, however long the prompt takes.
  security set-keychain-settings -l -u -t 3600 "$keychain" || {
    record FAIL "rotation while unlocked: could not raise the idle timeout"
    return
  }
  rotate_and_check "rotation while unlocked" "$unlocked_rotated_secret"

  # Reading the settings of a locked keychain opens a password dialog, and the
  # questions above may have outlasted the idle timeout.
  printf 'Reading the new settings. If it has locked since, Touch ID prompts once.\n'
  run_get
  settings="$(security show-keychain-info "$keychain" 2>&1)"
  [[ "$settings" == *lock-on-sleep* && "$settings" =~ timeout=[0-9]+s && "$settings" != *timeout=3600s* ]] \
    && record PASS "rotation while unlocked: the new keychain has its own settings" \
    || record FAIL "rotation while unlocked: unexpected keychain settings: $settings"

  security lock-keychain "$keychain"
  printf 'Locking it again. Touch ID should prompt once.\n'
  run_get
  got_exactly "$work/rotated" \
    && record PASS "rotation while unlocked: the new keychain unlocks after a lock" \
    || record FAIL "rotation while unlocked: after a lock, get exited $rc or returned different bytes"
}

# security -i splits long lines, so put refuses a secret whose line would pass
# 4000 bytes. Filling a line exactly shows the limit is below any split.
test_long_secret() {
  local overhead largest code
  overhead="$(printf 'add-generic-password -a touch-id-secret -s %s -w  "%s"\n' "$name" "$storage_directory/.$name.XXXXXX/$name.keychain-db" | wc -c)"
  largest=$(((4000 - overhead) / 2))
  head -c "$largest" /dev/zero | tr '\0' s >"$work/largest"
  { cat "$work/largest"; printf s; } >"$work/oversized"

  printf '\nLong secrets: %s bytes is the most that fits for this name. One more is refused with no prompt.\n' "$largest"
  "$command_path" put --force "$name" <"$work/oversized" >"$work/stdout" 2>"$work/stderr"
  code=$?
  [[ $code -eq 1 ]] && record PASS "an oversized secret exits 1" || record FAIL "an oversized secret exited $code"
  [[ ! -s "$work/stdout" ]] && record PASS "an oversized secret prints nothing to stdout" || record FAIL "an oversized secret wrote to stdout"
  grep -q 7373 "$work/stderr" \
    && record FAIL "an oversized secret reached stderr" \
    || record PASS "an oversized secret stays out of stderr"
  if compgen -G "$storage_directory/.$name.*" >/dev/null; then
    record FAIL "a refused secret left staging directories behind"
  else
    record PASS "a refused secret leaves nothing behind"
  fi
  if security find-generic-password -a touch-id-secret -s "$name" >/dev/null 2>&1; then
    record FAIL "an item for $name is on the keychain search list: remove it from the login keychain"
  else
    record PASS "no item reached the keychains on the search list"
  fi

  printf 'Storing the largest secret. Confirm the Touch ID prompt, then one more for the get.\n'
  "$command_path" put --force "$name" <"$work/largest"
  code=$?
  [[ $code -eq 0 ]] && record PASS "put stores the largest secret" || record FAIL "put on the largest secret exited $code"
  run_get
  got_exactly "$work/largest" \
    && record PASS "get returns the largest secret" \
    || record FAIL "on the largest secret, get exited $rc or returned different bytes"
}

set_up() {
  check_bin
  name="touch-id-secret-test-$$"
  directory="$storage_directory/$name"
  keychain="$directory/$name.keychain-db"
  work="$(mktemp -d "${TMPDIR:-/tmp}/test-touch-id-secret.XXXXXX")" || exit 1
  search_list_before="$(search_list)"
  trap cleanup EXIT
  printf '%s' "$dummy_secret" >"$work/expected"
}

run_long_secret() {
  set_up
  test_long_secret
  [[ $failures -eq 0 ]]
}

put_dummy() {
  printf 'Put: confirm the Touch ID prompt.\n'
  printf '%s' "$dummy_secret" | "$command_path" put "$name" || exit 1
}

run_sleep() {
  set_up
  put_dummy
  test_6
  [[ $failures -eq 0 ]]
}

run_timer() {
  set_up
  put_dummy
  test_timer_renewal
  [[ $failures -eq 0 ]]
}

run_rotation() {
  set_up
  put_dummy
  test_rotation
  test_rotation_unlocked
  [[ $failures -eq 0 ]]
}

run_all() {
  set_up
  printf 'Tools: age %s, age-plugin-se %s\n' "$(/opt/homebrew/bin/age --version)" "$(/opt/homebrew/bin/age-plugin-se --version)"
  /opt/homebrew/bin/age-plugin-se --help 2>&1 | grep -q 'any-biometry' \
    && record PASS "age-plugin-se --help lists any-biometry" \
    || record FAIL "age-plugin-se --help doesn't list any-biometry"

  test_validation
  test_put
  test_1
  test_2
  test_3
  test_timer_renewal
  test_4
  test_5
  test_6
  test_environment
  test_rotation
  test_rotation_unlocked
  test_long_secret
  test_put_lock

  printf '\nSummary (the search list check prints last):\n'
  printf '  %s\n' "${results[@]}"
  [[ $failures -eq 0 ]]
}

sandbox_prepare() {
  check_bin
  [[ ! -e "$storage_directory/$sandbox_name" ]] || sandbox_clean
  printf 'Confirm the Touch ID prompt.\n'
  printf '%s' "$dummy_secret" | "$command_path" put "$sandbox_name" || exit 1
  printf '\nCreated %s, locked. In the sandboxed session, run:\n  %s sandbox-check\n' "$sandbox_name" "$0"
  printf 'Then, to test reading while unlocked, run this outside the sandbox:\n  %s get %s >/dev/null\n' "$command_path" "$sandbox_name"
  printf 'and within the idle timeout run sandbox-check in the sandbox again. Finish with:\n  %s sandbox-clean\n' "$0"
}

sandbox_check() {
  local keychain="$storage_directory/$sandbox_name/$sandbox_name.keychain-db" lock_state lock_rc secret_hex expected_hex
  lock_state="$("$helper_path" "$keychain" 2>&1)"
  lock_rc=$?
  printf 'Helper: exit %s, output: %s\n' "$lock_rc" "$lock_state"
  printf 'Running get. If the helper said locked, Touch ID should prompt.\n'
  secret_hex="$("$command_path" get "$sandbox_name" | xxd -p | tr -d '\n'; exit "${PIPESTATUS[0]}")"
  rc=$?
  expected_hex="$(printf '%s' "$dummy_secret" | xxd -p | tr -d '\n')"
  printf 'get: exit %s\n' "$rc"
  if [[ $rc -eq 0 && "$secret_hex" == "$expected_hex" ]]; then
    printf 'RESULT: works from this session.\n'
  elif [[ $rc -eq 0 ]]; then
    printf 'RESULT: get exited 0 but returned different bytes.\n'
    exit 1
  elif [[ -z "$secret_hex" ]]; then
    printf 'RESULT: fails from this session, with empty stdout. The stderr above says where.\n'
    exit 1
  else
    printf 'RESULT: get failed but wrote to stdout.\n'
    exit 1
  fi
}

sandbox_clean() {
  remove_secret "$sandbox_name"
  printf 'Removed %s.\n' "$sandbox_name"
}

main() {
  case "${1:-all}" in
    all) run_all ;;
    sleep) run_sleep ;;
    timer) run_timer ;;
    rotation) run_rotation ;;
    long-secret) run_long_secret ;;
    sandbox-prepare) sandbox_prepare ;;
    sandbox-check) sandbox_check ;;
    sandbox-clean) sandbox_clean ;;
    *)
      printf 'usage: %s [sleep|timer|rotation|long-secret|sandbox-prepare|sandbox-check|sandbox-clean]\n' "$0" >&2
      exit 2
      ;;
  esac
}

# test-touch-id-secret-logic sources this file to check what its tests report.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
