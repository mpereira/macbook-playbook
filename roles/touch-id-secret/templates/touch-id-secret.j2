#!/bin/bash -p
# /usr/local/bin/touch-id-secret: keep a secret in a dedicated auto-locking
# keychain that Touch ID unlocks. Change it in roles/touch-id-secret, not in
# place.
#
# Usage: touch-id-secret put [--force] <name>    store the secret read from stdin
#        touch-id-secret get <name>              print the secret to stdout
#
# get prints exactly the bytes given to put. stdout carries nothing else. Exit
# status: 0 on success, 1 on any failure (a cancelled Touch ID prompt included),
# 2 on bad usage or an invalid name.
#
# Secrets and the keychain password never go in argv, the environment or a temp
# file. They travel through pipes to builtins and to security -i. Bash writes
# here-documents and here-strings to temp files, so they aren't used for them.
# -p above keeps an inherited SHELLOPTS=xtrace from printing them.
set -euo pipefail
umask 077

# Clear what the caller exported. age logs its file key under AGEDEBUG=plugin, and
# a local variable keeps the export attribute of an inherited one, so an exported
# "password" would hand the real one to every child process.
for variable in $(compgen -e); do
  if [[ "$variable" != HOME ]]; then
    unset "$variable" 2>/dev/null || true
  fi
done
unset variable

# Fixed, so a tool reached without a login PATH still finds age and its plugin,
# and a directory earlier in the caller's PATH can't intercept the password.
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
export LC_ALL=C

idle_timeout_seconds={{ touch_id_secret_idle_timeout_seconds | int }}
storage_directory="$HOME/.local/share/touch-id-secret"
item_account=touch-id-secret
# security -i splits a line at about 4096 bytes and runs the rest as a new command.
security_line_limit=4000

die() {
  printf 'touch-id-secret: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf 'usage: touch-id-secret put [--force] <name>    store the secret read from stdin\n' >&2
  printf '       touch-id-secret get <name>              print the secret to stdout\n' >&2
  exit 2
}

# Sets name and the paths that derive from it.
select_secret() {
  name="$1"
  if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; then
    printf 'touch-id-secret: invalid name: use up to 64 of A-Z a-z 0-9 . _ -, starting with a letter or digit\n' >&2
    exit 2
  fi
  directory="$storage_directory/$name"
}

# The path as one argument on a security -i line, which splits on whitespace and
# reads \" and \\ inside double quotes. It expands nothing.
security_argument() {
  local value="$1"
  [[ "$value" != *[[:cntrl:]]* ]] || die "can't pass a path with control characters to security: $value"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}

# Run the one command on stdin through security -i. Its exit status reflects only
# its last command, so a session gets exactly one.
security_stdin() {
  security -i >&2
}

lock_state() {
  touch-id-secret-lock-state "$1"
}

# The security -i line that stores the item, given the hex and the quoted keychain.
add_item_line() {
  printf 'add-generic-password -a %s -s %s -w %s %s\n' "$item_account" "$name" "$1" "$2"
}

clean_up() {
  if [[ -n "${staging:-}" ]]; then
    rm -rf "$staging" || true
  fi
  # A signal during the swap: put the old secret back, or finish removing it.
  if [[ -n "${previous:-}" && -e "$previous" ]]; then
    if [[ -e "$directory" ]]; then
      rm -rf "$previous" || true
    else
      mv "$previous" "$directory" || true
    fi
  fi
  if [[ -n "${put_lock:-}" ]]; then
    rmdir "$put_lock" || true
  fi
}

# Hold the name's lock until exit, so two runs can't both pass the existence
# checks and then publish over each other. mkdir either creates it or fails. A
# SIGKILL leaves the lock behind, which only blocks put, so the error names it.
take_put_lock() {
  local path="$storage_directory/.$name.lock"
  mkdir -p "$storage_directory"
  chmod 700 "$storage_directory"
  trap clean_up EXIT
  if ! mkdir "$path" 2>/dev/null; then
    [[ ! -e "$path" ]] || die "another put of '$name' is running. If none is, remove $path"
    die "could not create $path"
  fi
  put_lock="$path"
}

cmd_put() {
  local force=0 secret_hex line_length recipient password decrypted keychain quoted_keychain state stored_hex
  if [[ "${1:-}" == --force ]]; then
    force=1
    shift
  fi
  [[ $# -eq 1 ]] || usage
  select_secret "$1"
  take_put_lock

  if [[ -e "$directory" && $force -eq 0 ]]; then
    die "'$name' already exists: pass --force to replace it"
  fi
  [[ ! -t 0 ]] || die "reads the secret from stdin: redirect a file or pipe it, so a terminal doesn't echo it"

  # The item holds the secret hex-encoded. security -i takes one line per
  # command and find-generic-password -w isn't documented as byte-exact, while
  # hex keeps every byte and needs no quoting.
  secret_hex="$(xxd -p | tr -d '\n')" || die "could not read the secret from stdin"
  [[ -n "$secret_hex" ]] || die "the secret on stdin is empty"

  # A split line would store part of the secret in the default keychain and print
  # the rest, so refuse before anything runs. The staging path mktemp makes below
  # has this length.
  quoted_keychain="$(security_argument "$storage_directory/.$name.XXXXXX/$name.keychain-db")"
  line_length="$(add_item_line "$secret_hex" "$quoted_keychain" | wc -c)" \
    || die "could not measure the secret"
  if ((line_length > security_line_limit)); then
    die "the secret is too long: in hex it needs a $((line_length))-byte security -i line, and the limit is $security_line_limit"
  fi

  # Build everything aside, so a failure leaves any existing secret untouched.
  # A signal during mktemp would otherwise kill this shell before staging is set,
  # and clean_up couldn't find the directory. With a trap set, Bash waits for the
  # command to finish, so the signal lands after the assignment.
  trap 'exit 1' TERM INT HUP
  staging="$(mktemp -d "$storage_directory/.$name.XXXXXX")"
  trap - TERM INT HUP
  chmod 700 "$staging"

  # keygen prints the public key to stdout.
  age-plugin-se keygen --access-control=any-biometry -o "$staging/identity.txt" >&2 \
    || die "could not create a Secure Enclave identity"
  recipient="$(age-plugin-se recipients -i "$staging/identity.txt")" \
    || die "could not read the identity's recipient"

  password="$(head -c 32 /dev/urandom | xxd -p | tr -d '\n')" \
    || die "could not generate a keychain password"
  [[ "$password" =~ ^[0-9a-f]{64}$ ]] || die "generated a malformed keychain password"
  printf '%s' "$password" | age -r "$recipient" -o "$staging/keychain-password.age" \
    || die "could not encrypt the keychain password"

  # Prove Touch ID can open it now, rather than after the plaintext is gone. This
  # comes before the keychain exists so a slow prompt can't outlast its timer.
  printf 'touch-id-secret: confirm with Touch ID to check the new identity\n' >&2
  decrypted="$(age -d -i "$staging/identity.txt" "$staging/keychain-password.age")" \
    || die "could not decrypt with the new identity (Touch ID cancelled or failed)"
  [[ "$decrypted" == "$password" ]] || die "the new identity decrypted the wrong value"
  unset decrypted

  # create-keychain leaves the search list alone, so every call names the path.
  keychain="$staging/$name.keychain-db"
  quoted_keychain="$(security_argument "$keychain")"
  printf 'create-keychain -p %s %s\n' "$password" "$quoted_keychain" | security_stdin \
    || die "could not create the keychain"
  unset password
  [[ -f "$keychain" ]] || die "the keychain isn't at the expected path: $keychain"
  state="$(lock_state "$keychain")" || die "could not read the keychain's lock state"
  [[ "$state" == unlocked ]] || die "the new keychain is $state, expected unlocked"

  security set-keychain-settings -l -u -t "$idle_timeout_seconds" "$keychain" \
    || die "could not set the keychain's lock settings"
  add_item_line "$secret_hex" "$quoted_keychain" | security_stdin || die "could not store the secret"
  stored_hex="$(security find-generic-password -w -a "$item_account" -s "$name" "$keychain")" \
    || die "could not read the stored secret back"
  [[ "$stored_hex" == "$secret_hex" ]] || die "the stored secret doesn't match what was read"
  unset stored_hex secret_hex
  security lock-keychain "$keychain" || die "could not lock the keychain"

  # No keychain here is on the search list, so removing its file removes it.
  previous="$staging.previous"
  if [[ -e "$directory" ]]; then
    mv "$directory" "$previous" || die "could not move '$name' aside"
  fi
  if ! mv "$staging" "$directory"; then
    if [[ -e "$previous" ]]; then
      mv "$previous" "$directory" || true
    fi
    die "could not put the new '$name' in place"
  fi
  staging=""
  rm -rf "$previous"

  printf "touch-id-secret: stored '%s'\n" "$name" >&2
}

cmd_get() {
  local keychain state password quoted_keychain secret_hex
  [[ $# -eq 1 ]] || usage
  select_secret "$1"
  keychain="$directory/$name.keychain-db"
  [[ -f "$keychain" ]] || die "no secret named '$name'"

  # Reading a locked keychain with the security command opens a password dialog,
  # so read its state first. The timer can still expire between here and the read.
  state="$(lock_state "$keychain")" || die "could not read the keychain's lock state"
  if [[ "$state" == locked ]]; then
    password="$(age -d -i "$directory/identity.txt" "$directory/keychain-password.age")" \
      || die "could not decrypt the keychain password (Touch ID cancelled or failed)"
    # It ends up on a security -i line, where anything else could add arguments.
    [[ "$password" =~ ^[0-9a-f]{64}$ ]] || die "the decrypted keychain password is malformed"
    quoted_keychain="$(security_argument "$keychain")"
    printf 'unlock-keychain -p %s %s\n' "$password" "$quoted_keychain" | security_stdin \
      || die "could not unlock the keychain"
    unset password
    state="$(lock_state "$keychain")" || die "could not read the keychain's lock state"
    [[ "$state" == unlocked ]] || die "the keychain is still $state after unlocking"
  fi

  secret_hex="$(security find-generic-password -w -a "$item_account" -s "$name" "$keychain")" \
    || die "could not read the secret"
  [[ "$secret_hex" =~ ^([0-9a-f][0-9a-f])+$ ]] || die "the stored secret is malformed"
  printf '%s' "$secret_hex" | xxd -r -p
}

[[ $# -ge 1 ]] || usage
command="$1"
shift
case "$command" in
  put) cmd_put "$@" ;;
  get) cmd_get "$@" ;;
  *) usage ;;
esac
